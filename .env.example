# Contact form email (https://resend.com). Copy this file to .env.local and fill it in.
# Without RESEND_API_KEY the form shows an error asking visitors to email directly.
RESEND_API_KEY=
# Where enquiries go (default: hello@halcer.com)
CONTACT_TO=hello@halcer.com
# Sender. Must be on a domain verified in Resend, e.g. "Halcer Website <website@halcer.com>"
CONTACT_FROM="Halcer Website <onboarding@resend.dev>"
